
import os
import subprocess
import io
import pandas as pd

# 1. CONFIGURAÇÃO DE VARIÁVEIS
DB_FILE = "a.db"
OUTPUT_DIR = "./csvs"

# Garante que o arquivo do banco existe
if not os.path.exists(DB_FILE):
    print(f"Erro: O arquivo '{DB_FILE}' não foi encontrado!")
    exit(1)

# Cria a pasta de destino se não existir
os.makedirs(OUTPUT_DIR, exist_ok=True)

print(f"Iniciando exportação de: {DB_FILE}")

# 2. BUSCAR TODAS AS TABELAS (Tratando quebras de linha corretamente)
try:
    # O parâmetro -1 traz uma tabela por linha
    result = subprocess.run(['mdb-tables', '-1', DB_FILE], capture_output=True, text=True, check=True)
    # Remove linhas vazias e espaços extras do final de cada nome
    tables = [line.strip() for line in result.stdout.split('\n') if line.strip()]
except subprocess.CalledProcessError as e:
    print(f"Erro ao ler o banco. O mdbtools está instalado? Detalhes: {e}")
    exit(1)

# 3. CONVERTER CADA TABELA PARA CSV
for table in tables:
    print(f"Exportando tabela: {table}...")
    
    try:
        # Chamamos o mdb-export passando a tabela como um item separado na lista.
        # O Python cuida de proteger os espaços automaticamente para o sistema operacional!
        export_result = subprocess.run(['mdb-export', DB_FILE, table], capture_output=True, text=True, check=True)
        
        # Transformamos o texto retornado em um DataFrame do Pandas usando um buffer de memória
        df = pd.read_csv(io.StringIO(export_result.stdout))
        
        # Geramos o nome do arquivo final (mantendo o espaço ou tratando se preferir)
        csv_filename = f"{table}.csv"
        file_path = os.path.join(OUTPUT_DIR, csv_filename)
        
        # Salvamos o arquivo CSV de forma limpa
        df.to_csv(file_path, index=False)
        
    except subprocess.CalledProcessError as e:
        print(f"Erro ao exportar a tabela '{table}': {e.stderr}")
    except Exception as e:
        print(f"Erro inesperado na tabela '{table}': {e}")

print(f"Sucesso! Todos os arquivos foram salvos em: {OUTPUT_DIR}")

