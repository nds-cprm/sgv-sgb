import os
import duckdb

# 1. CONFIGURAÇÃO DE VARIÁVEIS
DB_FILE = "a.db"
OUTPUT_DIR = "./csvs"

# Garante que o arquivo do banco existe
if not os.path.exists(DB_FILE):
    print(f"Erro: O arquivo '{DB_FILE}' não foi encontrado!")
    exit(1)

# Cria a pasta de destino se não existir
os.makedirs(OUTPUT_DIR, exist_ok=True)

print(f"Iniciando exportação com DuckDB: {DB_FILE}")

# 2. INICIAR CONEXÃO E INSTALAR EXTENSÃO
# Criamos um banco temporário na memória
con = duckdb.connect(database=':memory:')

try:
    # Instala e carrega a extensão 'spatial' que sabe ler arquivos Access
    print("Carregando componentes de leitura de arquivos MS Access...")
    con.execute("INSTALL spatial;")
    con.execute("LOAD spatial;")
    
    # 3. BUSCAR TODAS AS TABELAS REALMENTE EXISTENTES DO ACCESS
    # Usamos a função st_layers para escanear a estrutura interna do arquivo
    tables_query = f"SELECT layer_name FROM st_layers('{DB_FILE}');"
    tables_result = con.execute(tables_query).fetchall()
    tables = [row[0] for row in tables_result]
    
    print(f"Tabelas encontradas no banco: {tables}")

    # 4. EXPORTAR CADA TABELA DIRETAMENTE PARA CSV
    for table in tables:
        # Substitui espaços por underlines no nome do arquivo final do Linux
        safe_filename = table.replace(" ", "_") + ".csv"
        file_path = os.path.join(OUTPUT_DIR, safe_filename)
        
        print(f"Exportando tabela: '{table}' -> {safe_filename}...")
        
        # O DuckDB possui o comando COPY ... TO que joga os dados direto para CSV de forma ultra rápida.
        # Colocamos o nome da tabela original entre aspas duplas dentro do comando para proteger os espaços!
        export_query = f"""
            COPY (SELECT * FROM st_read('{DB_FILE}', layer='"{table}"')) 
            TO '{file_path}' 
            (HEADER, DELIMITER ',');
        """
        con.execute(export_query)
        print(f"✅ Tabela '{table}' exportada com sucesso.")

except Exception as e:
    print(f"❌ Ocorreu um erro durante a exportação: {e}")
finally:
    con.close()

print(f"\nProcesso concluído! Verifique a pasta: {OUTPUT_DIR}")

