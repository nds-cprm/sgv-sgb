
import os
import pandas_access as mdb

# 1. SET YOUR VARIABLES
db_file = "a.db"
output_dir = "./csvs"

# Check if the database file exists
if not os.path.exists(db_file):
    print(f"Error: Database file '{db_file}' not found!")
    exit(1)

# Create the output folder if it does not exist
os.makedirs(output_dir, exist_ok=True)

print(f"Starting export for: {db_file}")

# 2. GET ALL TABLE NAMES
# This automatically handles spaces in table names
try:
    tables = mdb.list_tables(db_file)
except RuntimeError as e:
    print(f"Error reading database. Is mdbtools installed? Details: {e}")
    exit(1)

# 3. LOOP THROUGH EACH TABLE AND EXPORT TO CSV
for table in tables:
    print(f"Exporting table: {table}...")
    
    # Read the access table into a Pandas DataFrame
    df = mdb.read_table(db_file, table)
    
    # Create a safe filename by keeping or fixing the spaces
    csv_filename = f"{table}.csv"
    file_path = os.path.join(output_dir, csv_filename)
    
    # Save to CSV. index=False prevents adding an extra column of numbers
    df.to_csv(file_path, index=False)

print(f"Success! All CSV files are saved in: {output_dir}")

