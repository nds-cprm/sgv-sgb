import os
import pandas as pd
from access_parser import AccessParser

# 1. CONFIGURAÇÃO DE VARIÁVEIS
DB_FILE = "a.db"
OUTPUT_DIR = "./csvs"

# Garante que o arquivo do banco existe
if not os.path.exists(DB_FILE):
    print(f"Erro: O arquivo '{DB_FILE}' não foi encontrado!")
    exit(1)

# Cria a pasta de destino se não existir
os.makedirs(OUTPUT_DIR, exist_ok=True)

print(f"Iniciando extração estruturada de colunas com access-parser: {DB_FILE}")

try:
    # 2. CARREGAR O ARQUIVO ACCESS
    db = AccessParser(DB_FILE)
    tables = db.catalog
    print(f"Tabelas encontradas no catálogo: {list(tables.keys())}")
    
    # 3. EXPORTAR CADA TABELA
    for table_name in tables:
        # Substitui espaços por underlines no nome do arquivo final do CSV
        safe_filename = table_name.replace(" ", "_") + ".csv"
        file_path = os.path.join(OUTPUT_DIR, safe_filename)
        
        print(f"Processando tabela: '{table_name}' -> {safe_filename}...")
        
        try:
            # Extrai a tabela (Vem no formato: dicionário de colunas -> lista de linhas)
            parsed_table = db.parse_table(table_name)
            
            # CORREÇÃO CRÍTICA: Se vier como dicionário puro da biblioteca, tratamos coluna por coluna
            if isinstance(parsed_table, dict) and not isinstance(parsed_table, list):
                # Criamos um DataFrame vazio
                df = pd.DataFrame()
                
                # Preenchemos o DataFrame coluna por coluna com os dados mapeados pela biblioteca
                for col_name, col_values in parsed_table.items():
                    df[col_name] = col_values
            else:
                # Caso venha formatado como lista tradicional em alguma variação de versão
                df = pd.DataFrame(parsed_table)
            
            # Validação se os dados realmente existem
            if df.empty:
                print(f"⚠️  Aviso: A tabela '{table_name}' não possui registros válidos.")
                continue
            
            # Salva o arquivo CSV final
            df.to_csv(file_path, index=False, encoding='utf-8')
            print(f"✅ Sucesso: '{table_name}' exportada perfeitamente com {len(df)} linhas.")
            
        except Exception as table_err:
            print(f"❌ Não foi possível extrair os dados da tabela '{table_name}': {table_err}")

except Exception as e:
    print(f"❌ Erro crítico ao processar o banco de dados: {e}")

print(f"\nProcesso finalizado. Verifique a pasta: {OUTPUT_DIR}")

